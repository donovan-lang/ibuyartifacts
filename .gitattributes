# Normalize all text files to LF on commit and checkout
* text=auto eol=lf

# Explicitly binary files (never convert)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.svg binary
*.ttf binary
*.woff binary
*.woff2 binary
*.pdf binary
*.zip binary
*.gz binary
*.tar binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.pyc binary
*.pyd binary
*.db binary
*.sqlite binary
